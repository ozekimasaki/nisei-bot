{
  "name": "chisei-oss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:windows": "tsx scripts/windows-dev.ts",
    "check:windows": "tsx scripts/windows-check.ts",
    "db:windows:up": "podman compose up -d db",
    "db:windows:down": "podman compose down",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:normalize-memories": "tsx scripts/normalize-memories.ts",
    "db:normalize-memories:apply": "tsx scripts/normalize-memories.ts --apply",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcdice": "^4.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
